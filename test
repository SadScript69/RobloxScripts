-- =====================================
-- DISCORD WEBHOOK (INJECTION)
-- =====================================

local function sendWebhook()
	if not request then
		warn("Executor ne supporte pas HTTP request")
		return
	end

	local data = {
		username = "Script Logger",
		embeds = {{
			title = "📥 Script Injecté",
			color = 5793266,
			fields = {
				{ name = "🎮 Jeu", value = "Dress To Impress", inline = true },
				{ name = "👤 Joueur", value = player.Name, inline = true },
				{ name = "💰 Money", value = MoneyLabel.Text, inline = true },
				{ name = "🆔 UserId", value = tostring(player.UserId), inline = true }
			},
			timestamp = DateTime.now():ToIsoDate()
		}}
	}

	request({
		Url = WEBHOOK_URL,
		Method = "POST",
		Headers = {
			["Content-Type"] = "application/json"
		},
		Body = HttpService:JSONEncode(data)
	})
end

-- envoi UNE seule fois à l'injection
task.delay(2, sendWebhook)

-- =====================================
-- FARM LOOP
-- =====================================

task.spawn(function()
	while true do
		task.wait(0.1)
		if not farming or busy then continue end

		local snowflakeList = getAllSnowflakes()
		local moneyList = getAllMoney()

		local collectibles = {}
		for _, s in ipairs(snowflakeList) do table.insert(collectibles, s) end
		for _, m in ipairs(moneyList) do table.insert(collectibles, m) end

		local target = getClosest(collectibles)

		if target then
			busy = true
			local targetPos = target.Position
			root.CFrame = CFrame.new(targetPos.X, targetPos.Y + root.Size.Y/2, targetPos.Z)
			task.wait(PICKUP_DELAY)
			busy = false
		else
			task.wait(0.5)
		end
	end
end)

-- =====================================
-- STATS UPDATE
-- =====================================

task.spawn(function()
	while true do
		task.wait(1)
		local elapsed = tick() - startTime
		if elapsed > 0 then
			local currentMoney = tonumber(MoneyLabel.Text) or startMoney
			local currentSnowflakes = tonumber(SnowflakeLabel.Text) or startSnowflakes

			local moneyPerHour = math.floor(((currentMoney - startMoney)/elapsed) * 3600)
			local snowflakePerHour = math.floor(((currentSnowflakes - startSnowflakes)/elapsed) * 3600)

			moneyStat.Text = "Money/h : "..moneyPerHour
			snowflakeStat.Text = "Snowflakes/h : "..snowflakePerHour
		end
	end
end)

